{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["import", "jsx-a11y", "oxc", "react", "typescript", "unicorn", "eslint"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "options": {
    "typeAware": true
  },
  "rules": {
    "curly": ["error", "multi-line"],
    "eqeqeq": "error",
    "import/no-cycle": "error",
    "max-lines-per-function": [
      "error",
      {
        "max": 80,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-lines": [
      "error",
      {
        "max": 480,
        "skipBlankLines": true,
        "skipComments": true
      }
    ],
    "max-params": ["error", 4],
    "no-console": "allow",
    "no-empty": "error",
    "no-fallthrough": "error",
    "no-undef": "error",
    "no-unreachable-loop": "error",
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrors": "all",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-var": "error",
    "prefer-const": "error",
    "no-confusing-void-expression": "warn",
    "no-deprecated": "warn",
    "no-explicit-any": "error",
    "no-misused-promises": "error",
    "no-non-null-assertion": "error",
    "no-unnecessary-type-assertion": "error",
    "no-unexpected-multiline": "error",
    "only-throw-error": "error",
    "switch-exhaustiveness-check": "warn",
    "typescript/consistent-type-imports": [
      "error",
      { "prefer": "type-imports", "fixStyle": "separate-type-imports" }
    ],
    "no-const-enum": "error",
    "import/no-default-export": "error",
    "import/no-duplicates": "error",
    "import/no-unassigned-import": [
      "warn",
      {
        "allow": ["**/*.css", "hono"]
      }
    ],
    "react/iframe-missing-sandbox": "allow",
    "react/react-in-jsx-scope": "allow",
    "prefer-node-protocol": "error",
    "unicorn/no-array-for-each": "warn",
    "unicorn/no-empty-file": "warn"
  },
  "env": {
    "browser": true,
    "es2022": true,
    "node": true
  },
  "overrides": [
    {
      "files": [".pi/**/*.{ts,mts,cts}"],
      "rules": {
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.{test,spec}.{ts,tsx,mts,cts,js,jsx,mjs,cjs}"],
      "rules": {
        "no-empty": "off",
        "unicorn/no-empty-file": "off",
        "max-lines-per-function": [
          "error",
          {
            "max": 240,
            "skipBlankLines": true,
            "skipComments": true
          }
        ],
        "max-lines": [
          "error",
          {
            "max": 960,
            "skipBlankLines": true,
            "skipComments": true
          }
        ]
      }
    },
    {
      "files": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}", "pages/**/*.tsx"],
      "rules": {
        "no-unsafe-argument": "error",
        "no-unsafe-assignment": "error",
        "no-unsafe-call": "error",
        "no-unsafe-member-access": "error",
        "no-unsafe-return": "error",
        "import/no-default-export": "off"
      }
    },
    {
      "files": ["**/*.ts", "**/*.tsx"],
      "rules": { "no-undef": "off" }
    },
    {
      "files": ["**/*.config.{js,ts}", "vite.config.ts"],
      "rules": { "import/no-default-export": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules", ".next", "*.md"]
}
